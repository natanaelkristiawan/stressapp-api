# Local development only. Separate from the existing .env.
API_PORT=3100
MAIL_UI_PORT=8026
MYSQL_DATABASE=stressapp
MYSQL_USER=stressapp
MYSQL_PASSWORD=stressapp-local-only
MYSQL_ROOT_PASSWORD=stressapp-root-local-only
JWT_SECRET=replace-with-a-random-local-secret

# Defaults capture OTP emails locally in Mailpit. Set these for real SMTP delivery.
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_SECURE=false
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=Temu SoBAT <noreply@stressapp.test>
