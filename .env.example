DB_CONNECTION=
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE_MIMATE=
JWT_SECRET=
PORT=3111
CORS_ORIGINS=https://temusobat.tech,https://www.temusobat.tech,https://cms.temusobat.tech
REDIS_URL=
BULL_HOST=
BULL_PORT=6379
BULL_PASSWORD=
# Optional ACL user; leave blank for the default Redis user.
BULL_USERNAME=
BULL_TLS=false
KTB_SERVER=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
DEEPLINK=

# Resend SMTP. Store the replacement key only in your private server .env.
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USERNAME=resend
EMAIL_PASSWORD=
# Replace with an address from your Resend-verified domain.
EMAIL_FROM=Temu SoBAT <noreply@your-verified-domain.example>
EMAIL_FROM_ADDRESS=noreply@your-verified-domain.example

# MinIO S3 API (port 9000 behind HTTPS; not the console on port 9001).
S3_SPACES_ENDPOINT=https://minio.temusobat.tech
S3_REGION=us-east-1
S3_BUCKET=temusobat
S3_ACCESS_KEY=
S3_SECRET_KEY=
BASE_URL=https://api.temusobat.tech

# Separate PRIVATE bucket for mood images/audio; anonymous reads must be disabled.
S3_PRIVATE_BUCKET=temusobat-private
