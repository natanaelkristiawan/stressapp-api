DB_CONNECTION=
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE_MIMATE=
JWT_SECRET=
PORT=3111
CORS_ORIGINS=https://temusobat.tech,https://www.temusobat.tech,https://cms.temusobat.tech
REDIS_URL=
BULL_HOST=
BULL_PORT=6379
BULL_PASSWORD=
# Optional ACL user; leave blank for the default Redis user.
BULL_USERNAME=
BULL_TLS=false
KTB_SERVER=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
DEEPLINK=

# Resend SMTP. Store the replacement key only in your private server .env.
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USERNAME=resend
EMAIL_PASSWORD=
# Replace with an address from your Resend-verified domain.
EMAIL_FROM=Temu SoBAT <noreply@your-verified-domain.example>
EMAIL_FROM_ADDRESS=noreply@your-verified-domain.example

# MinIO S3 API (port 9000 behind HTTPS; not the console on port 9001).
S3_SPACES_ENDPOINT=https://s3.temusobat.tech
S3_REGION=us-east-1
S3_BUCKET=temu-sobat
S3_ACCESS_KEY=
S3_SECRET_KEY=
BASE_URL=https://api.temusobat.tech

# Firebase Admin: API-only credentials, outside the repository/app/CMS builds.
FIREBASE_PROJECT_ID=temu-sobat
GOOGLE_APPLICATION_CREDENTIALS=

# Server-only OpenCode Console inference (no OpenAI key required).
OPENCODE_API_KEY=
# Choose a Chat Completions model with JSON output support; verify before deployment.
OPENCODE_MODERATION_MODEL=
OPENCODE_MODERATION_TIMEOUT_MS=10000
OPENCODE_MODERATION_RETRY_ATTEMPTS=3
